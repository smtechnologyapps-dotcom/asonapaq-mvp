  "meta": {
    "title": "ASONAPAQ Logical Navigation & State Architecture Specification",
    "organization": "Asociación Nacional de Pacientes de Quimioterapia (ASONAPAQ)",
    "country": "República de Panamá",
    "foundation_year": 1989,
    "legal_framework": "Ley 81 de 2019 de Protección de Datos Personales de Panamá",
