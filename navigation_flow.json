        "allowed_transitions": [
          { "target": "auditoria_social", "trigger": "CLICK_AUDITORIA_SOCIAL" },
          { "target": "junta_tecnica", "trigger": "CLICK_JUNTA_TECNICA" },
          { "target": "inicio_publica", "trigger": "NAV_LOGOUT_ADMIN" }
